rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents & nested subcollections (verificationRequest, progress, etc.)
    match /users/{userId} {
      allow read, write: if request.auth != null;
      
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
